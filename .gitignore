# Runtime / rebuilt locally (setup_all / build_index / train)
storage/
*.joblib

# Harness: ignore ad-hoc runs; keep curated evidence snapshots (metrics + results)
evaluation/results/**
!evaluation/results/.gitkeep
!evaluation/results/validation_fairness_fix/
!evaluation/results/validation_fairness_fix/**
!evaluation/results/validation_hybrid_20261122T101209Z/
!evaluation/results/validation_hybrid_20261122T101209Z/**
!evaluation/results/validation_20261122T131433Z/
!evaluation/results/validation_20261122T131433Z/metrics.json
!evaluation/results/validation_20261122T131433Z/metrics.md
!evaluation/results/validation_20261122T131433Z/run_summary.json
# Decision dumps / full result dumps can get large — keep curated metrics only for generate-on
evaluation/results/**/decisions_export.jsonl
evaluation/results/**/results.jsonl

# Grafana scrape textfiles are regenerated; keep seeded comparison gauges
!observability/prometheus/textfile/
observability/prometheus/textfile/*
!observability/prometheus/textfile/.gitkeep
!observability/prometheus/textfile/validation_fairness_fix.prom
!observability/prometheus/textfile/validation_hybrid_20261122T101209Z.prom

