    {
      "id": 3,
      "title": "Mean confidence",
      "type": "gauge",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudserve_classification_confidence_sum / clamp_min(cloudserve_classification_confidence_count, 1)",
