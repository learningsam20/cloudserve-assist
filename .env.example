# Copy to .env and fill in values. Runtime code has NO fallback defaults —
# every key below is required (LITELLM_API_BASE may be left blank/omitted).

OPENROUTER_API_KEY=your_key_here
# Prefer a free-tier OpenRouter slug for Capstone cost limits (not openrouter/auto).
MODEL_NAME=openrouter/meta-llama/llama-3.1-8b-instruct
LITELLM_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct
# LITELLM_API_BASE=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MIN_DIM=32

CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=cloudserve_docs
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
# Measured 2026-11-22 (scripts/tune_threshold.py); pack 0.80 was illustrative (findings D3).
CONFIDENCE_THRESHOLD=0.35
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
# dense | hybrid | auto — auto runs dense first; hybrid only if top dense score < floor
RETRIEVAL_MODE=auto
# Dense quality floor for auto fallback (do not run hybrid until below this)
HYBRID_DENSE_SCORE_FLOOR=0.35
# RRF weight for dense ranks in [0,1]; lexical gets (1 - alpha)
HYBRID_DENSE_ALPHA=0.6
LEXICAL_INDEX_PATH=./storage/lexical_index.joblib
# If top passage score >= this and confidence >= CONFIDENCE_THRESHOLD * factor, allow auto
# (helps well-grounded tickets with lower classifier confidence — fairness for non_fluent wording)
ROUTE_GROUNDED_MIN_SCORE=0.45
ROUTE_GROUNDED_CONF_FACTOR=0.75
CHUNK_SIZE=800
CHUNK_OVERLAP=120
INDEX_BATCH_SIZE=64

CLASSIFIER_DIR=./storage/models/classifier
CLASSIFIER_FILENAME=classifier.joblib

KILL_SWITCH=false
KILL_SWITCH_FILE=./storage/KILL_SWITCH

API_HOST=0.0.0.0
API_PORT=8000
API_PID_FILE=./storage/api.pid
API_LOG_FILE=./storage/api.log

GEN_CACHE_DIR=./storage/gen_cache
PROMPT_FILE=./prompts/generate_v1.md
PROMPT_VERSION=PR-GEN-01-v1.0

# REQUIRED on clean checkout: absolute path to Capstone Pack 05_Datasets
# (default relative path only works when Capstone Pack sits beside this tree).
CAPSTONE_DATASETS=../capstone_guide/Capstone_Pack/05_Datasets

# Honour labels.must_not_auto_respond when present (Pack / hidden set). Set false for label-free API measurement.
USE_EVAL_LABELS=true

# Business / eval targets (findings D1 + Evaluation Framework)
TARGET_FCR_PCT=60
TARGET_REPLY_MEAN_MINUTES=5
TARGET_CSAT=4.0
TARGET_ESCALATION_PCT=30
TARGET_CLASSIFICATION_PRECISION=0.85
TARGET_LATENCY_P95_SECONDS=3.0
FAIRNESS_MAX_GAP_PP=5.0

# Threshold sweep bounds for scripts/tune_threshold.py
TUNE_THRESHOLD_MIN=0.30
TUNE_THRESHOLD_MAX=0.95
TUNE_THRESHOLD_STEP=0.05

# Classifier training hyperparameters
TRAIN_TEST_SIZE=0.2
TRAIN_SEED=42

# Generation sampling / resilience (LiteLLM → OpenRouter) — A11
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_SECONDS=1.0
